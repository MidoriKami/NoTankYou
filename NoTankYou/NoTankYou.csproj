<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<AssemblyVersion>7.4.4.7</AssemblyVersion>
	</PropertyGroup>

    <PropertyGroup>
        <Author>MidoriKami</Author>
        <Name>NoTankYou</Name>
        <Punchline>Warns you when yourself or others are missing role-specific actions</Punchline>
        <Description>Displays warnings when you or any party members are missing role specific actions such as partner buffs, pets, and tank stances.</Description>
        <RepoUrl>https://github.com/MidoriKami/NoTankYou</RepoUrl>
        <Tags>tanking;alerts;reminder;food;chocobo;spiritbond;gathering;warning</Tags>
        <AcceptsFeedback>false</AcceptsFeedback>
    </PropertyGroup>

    <!-- Temporary until Dalamud.NET.Sdk is updated to v16 -->
    <ItemGroup>
        <Reference Include="Dalamud.Common" Private="false" />
        <Reference Include="Dalamud.Excel.Sheets" Private="false" />
    </ItemGroup>
    <PropertyGroup>
        <Use_Dalamud_Lumina_Excel>false</Use_Dalamud_Lumina_Excel>
    </PropertyGroup>
    <!-- End Temporary Section -->

	<ItemGroup>
	  <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
	</ItemGroup>
</Project>
